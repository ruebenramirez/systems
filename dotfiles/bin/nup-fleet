#!/usr/bin/env bash

# Fleet-aware build: build on fwai0, deploy to targets.

# Simple NixOS fleet updater
# Just update your machines. Nothing fancy.

set -e

# Optional space/comma-separated names to skip. Used by CI to avoid
# updating the host the job itself runs on (`forgejo-ci-runner-vm`),
# whose switch would restart the runner mid-deploy.
EXCLUDE="${EXCLUDE:-}"
read -r -a MACHINES_EXCLUDE <<< "${EXCLUDE//,/ }"

skip_machine() {
    local name="$1" excluded
    for excluded in "${MACHINES_EXCLUDE[@]:-}"; do
        [[ -n "$excluded" && "$name" == "$excluded" ]] && return 0
    done
    return 1
}

# The fleet builder node. Builds are always offloaded here via
# `--build-host`; the only exception is when this script itself runs on the
# builder, where a local build is the remote build. Set
# ALLOW_LOCAL_BUILD=true to deliberately build on an underpowered host.
BUILDER_HOSTNAME="${BUILDER_HOSTNAME-fwai0}"
IS_BUILDER=false
if [[ -n "$BUILDER_HOSTNAME" && "$(hostname)" == "$BUILDER_HOSTNAME" ]]; then
    IS_BUILDER=true
fi

# Refuse to compile locally on anything that is not the builder. There is no
# silent fallback: if the builder is unreachable, `nixos-rebuild
# --build-host` fails, which is the desired behaviour.
if [[ "$IS_BUILDER" != "true" && "${ALLOW_LOCAL_BUILD:-false}" != "true" && -z "$BUILDER_HOSTNAME" ]]; then
    echo "error: no BUILDER_HOSTNAME and not on the builder; refusing to build locally." >&2
    echo "       set BUILDER_HOSTNAME=<host>, or ALLOW_LOCAL_BUILD=true to override." >&2
    exit 2
fi

FLAKE_DIR="${FLAKE_DIR:-/home/rramirez/code/systems}"

# Fleet from the flake; NUP_FLEET_MACHINES overrides it.
load_fleet() {
    if [[ -n "${NUP_FLEET_MACHINES:-}" ]]; then
        read -r -a MACHINES <<< "${NUP_FLEET_MACHINES//,/ }"
        echo "using NUP_FLEET_MACHINES override: ${MACHINES[*]}"
        return 0
    fi
    local names
    if ! names="$(
        nix eval --raw --impure \
            --extra-experimental-features 'nix-command flakes' \
            --expr "
                let flake = builtins.getFlake \"$FLAKE_DIR\";
                in builtins.concatStringsSep \"\\n\"
                     (builtins.attrNames flake.nixosConfigurations)
            "
    )"; then
        echo "error: could not evaluate nixosConfigurations from $FLAKE_DIR" >&2
        echo "       nup-fleet refuses to guess the fleet. Fix the flake, or set" >&2
        echo "       NUP_FLEET_MACHINES='host1 host2' to bypass it." >&2
        exit 3
    fi
    mapfile -t MACHINES <<< "$names"
    if [[ ${#MACHINES[@]} -eq 0 || -z "${MACHINES[0]}" ]]; then
        echo "error: $FLAKE_DIR declares no nixosConfigurations; refusing to deploy nothing" >&2
        exit 3
    fi
}

load_fleet

# Optional SSH user override. If unset, SSH resolves the user per host
# from ~/.ssh/config. Set SSH_USER=root to force a different user.
SSH_USER="${SSH_USER:-}"

# Build an ssh target string, honoring the SSH_USER override if set.
ssh_target() {
    if [[ -n "$SSH_USER" ]]; then
        printf '%s@%s' "$SSH_USER" "$1"
    else
        printf '%s' "$1"
    fi
}

# ---------------------------------------------------------------------------
# Private flake inputs
# ---------------------------------------------------------------------------

# The host that serves the private `systems-secrets` flake input over https.
# Override for a mirror or a different Forgejo host.
PRIVATE_GIT_HOST="${PRIVATE_GIT_HOST:-code.rueb.dev}"

# Never let git fall back to an interactive `Username for 'https://...'` prompt.
# Exported (not just set for our own git calls) because the git subprocesses nix
# spawns inherit it: that is the point. Without this, a missing or rejected
# credential hangs the run -- and on 2026-10-27 an interrupted prompt left a
# rewritten flake.lock behind on its way out. A private input that cannot
# authenticate must fail loudly, not wait for a human at 03:30.
export GIT_TERMINAL_PROMPT=0

# Is there a credential git could use for a host? Checks the two places git
# itself looks, in the order it looks: credential helpers, then ~/.netrc.
# Note `git credential fill` does NOT read ~/.netrc (that is libcurl's job in
# the http transport), so both checks are needed.
has_git_credential() {
    local host="$1" netrc="${NETRC:-$HOME/.netrc}"

    if printf 'protocol=https\nhost=%s\n\n' "$host" |
        git -c credential.interactive=false credential fill 2>/dev/null |
        grep -q '^password=.'; then
        return 0
    fi

    [[ -r "$netrc" ]] || return 1
    awk -v host="$host" '
        {
            for (i = 1; i <= NF; i++) {
                tok = $i
                if (tok == "machine") {
                    want = ($(i + 1) == host)
                } else if (tok == "default" || tok == "account") {
                    want = 1
                } else if (want && tok == "password" && $(i + 1) != "") {
                    found = 1
                    exit
                }
            }
        }
        END { exit !found }
    ' "$netrc"
}

# Fail before `nix flake update` rather than in the middle of it, with the fix
# in the message. Workstations have no credential for the private input unless
# someone puts the Forgejo token in ~/.netrc; only the CI runner gets one from
# sops. See README, "Credentials for the private input".
preflight_private_input() {
    has_git_credential "$PRIVATE_GIT_HOST" && return 0
    cat >&2 <<EOF
error: no git credential for $PRIVATE_GIT_HOST, so 'nix flake update' cannot
       resolve the private 'systems-secrets' input. Prompts are disabled
       (GIT_TERMINAL_PROMPT=0), so this fails instead of hanging on
       "Username for 'https://$PRIVATE_GIT_HOST':".

       Give the invoking user a Forgejo token:

         scripts/setup-forgejo-netrc.sh                      # prompt for one
         scripts/setup-forgejo-netrc.sh --from-runner <host>  # copy the runner's

       or write \$HOME/.netrc (mode 0600) by hand:

         machine $PRIVATE_GIT_HOST
           login <forgejo-user>
           password <token>

       Or skip the update and deploy the revision already in flake.lock:

         nup-fleet ${NUP_FLEET_ARG_HINT:-<machine>}
EOF
    return 1
}

# Inputs whose locked revision moved *backwards* between two lock files. That is
# what an expired cached ref looks like once it has been written down: nix
# resolved the input from its shallow cache instead of the remote and locked an
# older rev than the one already recorded. Detected on the lock file rather than
# by grepping nix's warning text, so it also catches a warning that never made it
# to the log because the run died fetching the tree it had just re-locked.
lock_regressions() {
    local before="$1" after="$2"
    [[ -s "$before" && -s "$after" ]] || return 0
    command -v jq >/dev/null 2>&1 || return 0
    join -t$'\t' -j1 \
        <(jq -r '.nodes | to_entries[]
                 | select(.value.locked.lastModified != null)
                 | "\(.key)\t\(.value.locked.lastModified)"' "$before" | sort) \
        <(jq -r '.nodes | to_entries[]
                 | select(.value.locked.lastModified != null)
                 | "\(.key)\t\(.value.locked.lastModified)"' "$after" | sort) \
        | awk -F'\t' '$2 > $3 { printf "%s (lastModified %s -> %s)\n", $1, $2, $3 }'
}

nix_flake_update() {
    echo "updating nix flake"
    cd "$FLAKE_DIR"
    preflight_private_input || return 1

    # `nix flake update` exits 0 even when it cannot reach a private flake
    # input. It prints
    #   warning: could not get HEAD ref for repository '<url>'; using expired
    #   cached ref 'refs/heads/...'
    # and keeps the previously locked revision. For `systems-secrets` that
    # means the whole fleet gets rebuilt against *stale* secret material while
    # CI reports success -- exactly the failure mode that hid itself for a full
    # fleet run on 2026-10-26. Treat the warning as fatal.
    #
    # Keep the pre-update lock so none of these failures can leave a half-moved
    # lock behind: the interrupted run on 2026-10-27 rewrote flake.lock with a
    # *stale* systems-secrets rev (88 -> 86) while exiting 1, and a deploy from
    # that lock would have shipped older secret material to the fleet.
    local log lock_backup rc reason regressions
    log="$(mktemp)"
    lock_backup="$(mktemp)"
    [[ -f flake.lock ]] && cp flake.lock "$lock_backup"
    set +e
    nix flake update 2>&1 | tee "$log"
    rc=${PIPESTATUS[0]}
    set -e

    regressions="$(lock_regressions "$lock_backup" flake.lock)"

    reason=""
    if (( rc != 0 )); then
        reason="nix flake update failed (exit $rc)"
    elif grep -qE "could not get HEAD ref|expired cached ref" "$log"; then
        reason="nix flake update could not refresh an input and fell back to an
               EXPIRED CACHED REF. A private flake input (systems-secrets) is not
               reachable from this environment. Two usual causes:
                 1. HOME is not the deploy home -- git reads ~/.netrc, not
                    nix's netrc-file setting (CI: /var/lib/nixdeploy).
                 2. An http.<host>/.extraheader in the enclosing repo's local
                    config (actions/checkout sets one) is overriding the
                    netrc; blank it with GIT_CONFIG_KEY_0/GIT_CONFIG_VALUE_0."
    elif [[ -n "$regressions" ]]; then
        reason="flake.lock moved at least one input BACKWARDS, i.e. nix locked a
               stale cached revision instead of the remote head:
                 $regressions"
    fi

    if [[ -n "$reason" ]]; then
        echo "error: $reason" >&2
        if [[ -s "$lock_backup" ]] && ! cmp -s "$lock_backup" flake.lock; then
            cp "$lock_backup" flake.lock
            echo "       flake.lock restored to its pre-update state." >&2
        fi
        rm -f "$log" "$lock_backup"
        return 1
    fi
    rm -f "$log" "$lock_backup"
}

# Machines that failed this run. `all` keeps going past a failure so one
# broken host does not leave the rest of the fleet un-deployed, then exits
# non-zero so CI still reports the failure.
FAILED=()

update_machine() {
    local host_config="$1"
    IFS=':' read -r hostname config <<< "$host_config"
    echo "Updating $hostname ($config)..."
    local builder=()
    if [[ "$IS_BUILDER" != "true" ]]; then
        builder=(--build-host "$(ssh_target "$BUILDER_HOSTNAME")")
    fi
    # Do not let a single failure abort the caller's loop; record it instead.
    if ! time nixos-rebuild switch \
        --flake "$FLAKE_DIR#$config" \
        "${builder[@]}" \
        --target-host "$(ssh_target "$hostname")" \
        --sudo \
        --use-substitutes \
        --no-reexec; then
        echo "✗ $hostname failed" >&2
        FAILED+=("$hostname")
        return 1
    fi
    echo "✓ $hostname updated"
}

# ---------------------------------------------------------------------------
# check -- validate the flake; deploys nothing and switches nothing
#
# Everything heavy runs on the builder. The runner is a 4-core VM with 3.7G of
# RAM and evaluating the whole fleet in it peaked at 3.5G, which is more than it
# has: that nix is a child of forgejo-runner.service, so the OOM killer took the
# runner down with the job. Here the invoking host only parses and ships paths;
# the evaluation and every build happen on the builder and stay there.
# ---------------------------------------------------------------------------

# Set by the `check` action: the ssh target that does the heavy work, empty when
# this host is the builder.
CHECK_HOST=""

# Run a command where the heavy lifting belongs: here when this is the builder,
# over ssh otherwise.
on_builder() {
    if [[ -n "$CHECK_HOST" ]]; then
        ssh "$CHECK_HOST" "$@"
    else
        "$@"
    fi
}

# Parse every Nix file in the tree, including ones no configuration imports.
# Evaluation only parses what it reaches, so a syntax error in a template or in
# an unpackaged derivation is invisible to it.
check_parse() {
    local -a files=()
    mapfile -d '' files < <(
        find "$FLAKE_DIR" \( -name .git -o -name .jj -o -name result \) -prune \
            -o -name '*.nix' -print0 | sort -z
    )
    if [[ ${#files[@]} -eq 0 ]]; then
        echo "error: no .nix files found under $FLAKE_DIR" >&2
        return 1
    fi
    echo "Parsing ${#files[@]} Nix file(s)..."
    if ! nix-instantiate --parse "${files[@]}" >/dev/null; then
        echo "✗ Nix syntax errors (listed above)" >&2
        return 1
    fi
    echo "✓ ${#files[@]} file(s) parse"
}

# The flake source nix would evaluate, as a store path: what gets shipped to the
# builder so it can do the evaluating. `nix flake metadata` resolves the lock
# without evaluating any output.
check_source() {
    nix flake metadata --json "$FLAKE_DIR" | jq -r .path
}

# Ship the flake source and every locked input to the builder so the evaluation
# there resolves exactly what flake.lock names -- including the private
# systems-secrets input, which the builder may hold no credential for: this host
# fetches it with its own netrc and copies it over. `nix copy` is a no-op for
# whatever the builder already has, which after a nightly is everything.
check_ship() {
    local src="$1"
    [[ -n "$CHECK_HOST" ]] || return 0
    local inputs line
    if ! inputs="$(
        nix eval --raw --impure \
            --extra-experimental-features 'nix-command flakes' \
            --expr "
                let flake = builtins.getFlake \"$FLAKE_DIR\";
                in builtins.concatStringsSep \"\\n\"
                     (map (i: i.outPath) (builtins.attrValues flake.inputs))
            "
    )"; then
        echo "✗ could not resolve the flake inputs to ship to $CHECK_HOST" >&2
        return 1
    fi
    local -a paths=("$src")
    while IFS= read -r line; do
        [[ -n "$line" ]] && paths+=("$line")
    done <<< "$inputs"
    echo "Shipping the flake source and $(( ${#paths[@]} - 1 )) input(s) to $CHECK_HOST..."
    nix copy --to "ssh://$CHECK_HOST" "${paths[@]}"
}

# `nix flake check --no-build` on the builder: forces every nixosConfigurations
# entry to its toplevel derivation -- where a mistyped option, a bad type or a
# broken module shows up -- and validates the shape of every other output,
# without compiling anything. Measured 26s at 5G on fwai0.
check_eval() {
    local src="$1"
    echo "Checking the flake evaluates on ${CHECK_HOST:-$(hostname)} (nothing is built)..."
    if ! on_builder nix flake check --no-build --no-write-lock-file "$src"; then
        echo "✗ the flake does not evaluate" >&2
        return 1
    fi
    echo "✓ flake evaluates"
}

# Runs on the builder: prints "config<TAB>drvPath" for each name in its
# arguments, one process for the whole list because every `nix eval` re-imports
# nixpkgs. Sent as a script on stdin rather than as ssh arguments because the
# builder's login shell is fish, which would try to expand the `${...}` in the
# Nix expression.
readonly CHECK_DRVS_SCRIPT='
set -euo pipefail
src="$1"
shift
list=""
for name in "$@"; do
    list="$list\"$name\" "
done
nix eval --raw --impure \
    --extra-experimental-features "nix-command flakes" \
    --expr "
        let
          flake = builtins.getFlake \"$src\";
          one = name:
            \"\${name}\\t\${flake.nixosConfigurations.\"\${name}\".config.system.build.toplevel.drvPath}\";
        in builtins.concatStringsSep \"\\n\" (builtins.map one [ $list ])
"
'

# Configuration -> .drv path, filled in by check_drvs and used by check_build.
# The .drv lands in the builder's store as a side effect of evaluating there, so
# the build phase has nothing to ship.
declare -A DRV_OF=()

check_drvs() {
    local src="$1"
    shift
    local -a configs=("$@")
    local out name drv
    echo "Evaluating ${#configs[@]} configuration(s) on ${CHECK_HOST:-$(hostname)}..."
    if ! out="$(on_builder bash -s -- "$src" "${configs[@]}" <<< "$CHECK_DRVS_SCRIPT")"; then
        echo "✗ could not evaluate the toplevel derivations for: ${configs[*]}" >&2
        return 1
    fi
    while IFS=$'\t' read -r name drv; do
        [[ -n "$name" ]] && DRV_OF["$name"]="$drv"
    done <<< "$out"
    local -a missing=()
    for name in "${configs[@]}"; do
        [[ -n "${DRV_OF[$name]:-}" ]] || missing+=("$name")
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "✗ no derivation was evaluated for: ${missing[*]}" >&2
        return 1
    fi
    echo "✓ ${#configs[@]} configuration(s) evaluate"
}

# Realise each configuration on the builder and leave the result there, so the
# invoking host never compiles and no system closure is shipped back to it. The
# build log streams over ssh and the builder's exit status is what gets reported.
# A builder warmed by the nightly realises an unchanged configuration in about a
# second.
#
# `nix build --store ssh://<host> <drv>` looks like the same thing and is not:
# it treats the .drv as a store path to copy, builds nothing and exits 0.
check_build() {
    local -a configs=("$@")
    local -a failed=() name
    for name in "${configs[@]}"; do
        echo "Building $name on ${CHECK_HOST:-$(hostname)}..."
        on_builder nix-store --realise "${DRV_OF[$name]}" || failed+=("$name")
    done
    if [[ ${#failed[@]} -gt 0 ]]; then
        echo
        echo "Failed builds (${#failed[@]}): ${failed[*]}" >&2
        return 1
    fi
    echo "✓ ${#configs[@]} configuration(s) build on ${CHECK_HOST:-$(hostname)}"
}

usage() {
    cat <<'USAGE'
usage: nup-fleet [--upgrade|--update] [machine ...]
       nup-fleet --flake-update-only
       nup-fleet build [machine ...]
       nup-fleet check [--no-build] [machine ...]
       nup-fleet rollback machine [machine ...]
       nup-fleet --list

  --upgrade / --update   run `nix flake update` first, then deploy
  --flake-update-only    run `nix flake update` and stop: no build, no deploy.
                         The CI sops preflight uses it so the check reads the
                         revisions the deploy is about to use, not whatever the
                         committed lock happens to point at.
  machine ...            host or flake config name(s); repeat as many as you
                         like. Default: the whole fleet. EXCLUDE is consulted
                         for the whole-fleet run only -- a machine named on the
                         command line is deployed exactly as asked.
  build                  build configurations without deploying
  check / --check        validate without deploying: parse every .nix file, then
                         evaluate the flake and build each configuration on the
                         builder, leaving the results there. Only the parse runs
                         locally. Stops at the first phase that fails; EXCLUDE
                         is not consulted.
  --no-build             with check: stop after evaluation (fastest local check)
  rollback               switch each named machine back to the generation it was
                         on before the last deploy. Never operates on the whole
                         fleet by accident: names are required. This is the
                         supported recovery after a bad switch -- stage-2
                         activation does not undo itself.
  --list                 print every accepted machine name and exit
USAGE
}

UPDATE=false
FLAKE_ONLY=false
LIST=false
ACTION="deploy"
CHECK_BUILD=true
args=()
for arg in "$@"; do
    case "$arg" in
        --update|--upgrade) UPDATE=true ;;
        --flake-update-only) UPDATE=true; FLAKE_ONLY=true ;;
        --list)             LIST=true ;;
        -h|--help)          usage; exit 0 ;;
        --check)            ACTION=check ;;
        --no-build)         CHECK_BUILD=false ;;
        build)              ACTION=build ;;
        check)              ACTION=check ;;
        rollback)           ACTION=rollback ;;
        all)                ACTION=deploy ;;
        *)                  args+=("$arg") ;;
    esac
done

if [[ "$LIST" == "true" ]]; then
    for machine in "${MACHINES[@]}"; do
        IFS=':' read -r hostname config <<< "$machine"
        printf '%s\n' "$hostname"
        if [[ -n "$config" && "$config" != "$hostname" ]]; then
            printf '%s\n' "$config"
        fi
    done
    exit 0
fi

# Resolve one CLI name (host name or flake config name) to its MACHINES entry.
resolve_machine() {
    local target="$1" machine hostname config
    for machine in "${MACHINES[@]}"; do
        IFS=':' read -r hostname config <<< "$machine"
        if [[ "$hostname" == "$target" || "$config" == "$target" ]]; then
            printf '%s\n' "$machine"
            return 0
        fi
    done
    return 1
}

# Resolve names before `nix flake update` so typos fail fast.
WHOLE_FLEET=false
TARGETS=()
if [[ ${#args[@]} -eq 0 ]]; then
    WHOLE_FLEET=true
    TARGETS=("${MACHINES[@]}")
else
    for target in "${args[@]}"; do
        if machine="$(resolve_machine "$target")"; then
            TARGETS+=("$machine")
        else
            echo "error: unknown machine '$target'" >&2
            echo "       available: ${MACHINES[*]}" >&2
            echo "       (or run: nup-fleet --list)" >&2
            exit 1
        fi
    done
fi

if [[ "$UPDATE" == "true" ]]; then
    # What to re-run without --upgrade, quoted in the credential preflight.
    if [[ "$FLAKE_ONLY" == "true" ]]; then
        NUP_FLEET_ARG_HINT="all"
    else
        NUP_FLEET_ARG_HINT="${TARGETS[0]%%:*}"
    fi
    nix_flake_update
fi

# The lock has moved and that is the whole request: nothing is built or deployed.
if [[ "$FLAKE_ONLY" == "true" ]]; then
    echo "flake.lock updated; --flake-update-only, deploying nothing."
    exit 0
fi

# nixos-rebuild-ng can choke when the CWD is inside the flake
# (see nixpkgs#418868) during remote build/deploy. Run from a neutral dir.
cd "$HOME"

# ---------------------------------------------------------------------------
# rollback -- switch a machine back to the generation it was on before the last
# deploy. `switch` applies changes incrementally and does not undo itself, so an
# explicit way back has to exist outside the deploy path.
# ---------------------------------------------------------------------------
rollback_machine() {
    local host_config="$1"
    IFS=':' read -r hostname config <<< "$host_config"
    local target; target="$(ssh_target "$hostname")"
    # `--rollback` still needs a flake argument: nixos-rebuild builds its remote
    # helper (`config.system.build.nixos-rebuild`) from it, and without one it
    # falls back to <nixpkgs> and dies on an empty NIX_PATH. The generation it
    # switches to is the profile's previous one on the target, not this flake.
    local builder=()
    if [[ "$IS_BUILDER" != "true" ]]; then
        builder=(--build-host "$(ssh_target "$BUILDER_HOSTNAME")")
    fi
    echo "Generations on $hostname before rollback:"
    nixos-rebuild list-generations --target-host "$target" || true
    if ! nixos-rebuild switch --rollback \
        --flake "$FLAKE_DIR#$config" \
        "${builder[@]}" \
        --target-host "$target" \
        --sudo; then
        echo "✗ $hostname rollback failed" >&2
        return 1
    fi
    echo "Generations on $hostname after rollback:"
    nixos-rebuild list-generations --target-host "$target" || true
    echo "✓ $hostname rolled back"
}

case "$ACTION" in
    "check")
        CHECK_HOST=""
        [[ "$IS_BUILDER" == "true" ]] || CHECK_HOST="$(ssh_target "$BUILDER_HOSTNAME")"
        # A fleet entry is "host" or "host:config"; the flake-derived fleet has
        # no colon, in which case the host name is the configuration name.
        CHECK_CONFIGS=()
        for target in "${TARGETS[@]}"; do
            IFS=':' read -r hostname config <<< "$target"
            CHECK_CONFIGS+=("${config:-$hostname}")
        done
        # Each phase is a superset of the previous one's work, so stop at the
        # first failure instead of shipping and evaluating a tree that does not
        # even parse.
        check_parse || exit 1
        CHECK_SRC="$(check_source)"
        if [[ -z "$CHECK_SRC" ]]; then
            echo "error: could not resolve the flake source of $FLAKE_DIR" >&2
            exit 1
        fi
        check_ship "$CHECK_SRC" || exit 1
        check_eval "$CHECK_SRC" || exit 1
        check_drvs "$CHECK_SRC" "${CHECK_CONFIGS[@]}" || exit 1
        if [[ "$CHECK_BUILD" == "true" ]]; then
            check_build "${CHECK_CONFIGS[@]}"
        else
            echo "Skipping the build phase (--no-build)."
        fi
        ;;
    "rollback")
        if [[ "$WHOLE_FLEET" == "true" ]]; then
            echo "error: rollback requires explicit machine names" >&2
            echo "       usage: nup-fleet rollback <host> [<host> ...]" >&2
            exit 1
        fi
        for machine in "${TARGETS[@]}"; do
            rollback_machine "$machine" || FAILED+=("$machine")
        done
        [[ ${#FAILED[@]} -eq 0 ]] || { echo "failed: ${FAILED[*]}" >&2; exit 1; }
        ;;
    "build")
        # Build-only action (no deploy). Offload to the builder if we are not
        # already running on it.
        if [[ "$IS_BUILDER" == "true" ]]; then
            echo "Building ${#TARGETS[@]} configuration(s) locally (on builder)..."
        else
            echo "Building ${#TARGETS[@]} configuration(s) on $BUILDER_HOSTNAME..."
        fi
        for machine in "${TARGETS[@]}"; do
            IFS=':' read -r hostname config <<< "$machine"
            echo "Building $config..."
            build_args=()
            if [[ "$IS_BUILDER" != "true" ]]; then
                build_args=(--build-host "$(ssh_target "$BUILDER_HOSTNAME")")
            fi
            nixos-rebuild build \
                --flake "$FLAKE_DIR#$config" \
                "${build_args[@]}"
        done
        ;;
    "deploy")
        for machine in "${TARGETS[@]}"; do
            IFS=':' read -r hostname _config <<< "$machine"
            if [[ "$WHOLE_FLEET" == "true" ]] && skip_machine "$hostname"; then
                echo "Skipping $hostname (excluded)"
                continue
            fi
            # Continue past failures; the run is summarised at the end.
            update_machine "$machine" || true
        done
        if [[ ${#FAILED[@]} -gt 0 ]]; then
            echo
            echo "Failed machines (${#FAILED[@]}): ${FAILED[*]}" >&2
            exit 1
        fi
        echo
        echo "All ${#TARGETS[@]} machine(s) updated."
        ;;
esac
