#!/usr/bin/env bash

# Simple NixOS fleet updater
# Just update your machines. Nothing fancy.

set -e

MACHINES=(
    "xps17"
    "dev-vm-xps"
    "fwai0"
    "homeserver"
    "driver"
    "ssdnodes-1"
    "download-vm-xps"
    "forgejo-ci-runner-vm"
    "pi-syncoid-target"
)

FLAKE_DIR="${FLAKE_DIR:-/home/rramirez/code/systems}"
SSH_USER="${SSH_USER:-rramirez}"

nix_flake_update() {
    echo "updating nix flake"
    cd $FLAKE_DIR
    nix flake update
}

update_machine() {
    local host_config="$1"
    IFS=':' read -r hostname config <<< "$host_config"
    echo "Updating $hostname ($config)..."
    ssh -t "$SSH_USER@$hostname" "sudo ip link delete dev wg0 && sudo systemctl restart wg-quick-wg0.service || true"
    time nixos-rebuild switch \
        --flake "$FLAKE_DIR#$config" \
        --target-host "$SSH_USER@$hostname" \
        --sudo \
        --no-reexec
    echo "✓ $hostname updated"
}

UPDATE=false
args=()
for arg in "$@"; do
    if [[ "$arg" == "--update" || "$arg" == "--upgrade" ]]; then
        UPDATE=true
    else
        args+=("$arg")
    fi
done

if [[ "$UPDATE" == "true" ]]; then
    nix_flake_update
fi

case "${args[0]:-all}" in
    "all")
        for machine in "${MACHINES[@]}"; do
            update_machine "$machine"
        done
        ;;
    "build")
        echo "Building all configurations locally..."
        for machine in "${MACHINES[@]}"; do
            IFS=':' read -r hostname config <<< "$machine"
            echo "Building $config..."
            nixos-rebuild build --flake "$FLAKE_DIR#$config"
        done
        ;;
    *)
        # Update specific machine
        target="${args[0]}"
        found=false
        for machine in "${MACHINES[@]}"; do
            IFS=':' read -r hostname config <<< "$machine"
            if [[ "$hostname" == "$target" || "$config" == "$target" ]]; then
                update_machine "$machine"
                found=true
                break
            fi
        done
        if [[ "$found" == "false" ]]; then
            echo "Machine '$target' not found"
            echo "Available: ${MACHINES[*]}"
            exit 1
        fi
        ;;
esac
